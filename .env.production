# PR Fix Agent - Production Environment Variables
# Copy this to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/prfixagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=prfixagent

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# LLM Configuration
OLLAMA_BASE_URL=http://ollama:11434
HF_API_TOKEN=your-huggingface-token-here

# Security
SECRET_KEY=your-secret-key-here-min-32-chars
SELF_HEALING_KEY=your-webhook-key-here

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=admin

# Environment
ENVIRONMENT=production
DEBUG=false
